---
import { Image, getImage } from 'astro:assets';
import '@fontsource-variable/geist';
import '../styles/global.css';
import FeatureDiagram from '../components/FeatureDiagram.astro';
import browser from '../assets/metope-browser.png';
import limestone from '../assets/limestone.png';
const texture = await getImage({ src: limestone, width: 1200, format: 'webp', quality: 75 });
const download = '/downloads/Metope-0.1.0-arm64.zip';
const features = [
  { kind: 'browse' as const, title: 'Find the file you need.', description: 'Switch between list and icon views, search the current folder, and preview files with Quick Look.', detail: 'Folder search · Quick Look · File inspector' },
  { kind: 'organize' as const, title: 'Put things in order.', description: 'Create folders, rename files, and delete what you no longer need. Work with your Android storage from your Mac.', detail: 'New folders · Rename · Delete' },
  { kind: 'transfer' as const, title: 'See what’s transferring.', description: 'Send a folder to your phone or save it to your Mac. Queue the next transfer, follow progress, and cancel when needed.', detail: 'Transfer queue · Progress · History' },
];
const shortcuts = [['Quick Look', 'Space'], ['Send to phone', '⌘ U'], ['Save to Mac', '⌘ S'], ['Inspector', '⌥ ⌘ I'], ['Transfer history', '⌘ J'], ['Refresh', '⌘ R']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Android file transfer in a 5 MB native Mac app. Written in Swift. Browse, organize, and move files over USB with Metope." />
    <meta name="theme-color" content="#f7f7f4" />
    <link rel="canonical" href="https://metope.org/" />
    <meta property="og:title" content="Metope — Android file transfer. Built for the Mac." />
    <meta property="og:description" content="A small, native Swift app for browsing, organizing, and transferring Android files over USB." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://metope.org/" />
    <meta property="og:image" content="https://metope.org/images/metope-icon-large.png" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/images/metope-icon.png" />
    <link rel="apple-touch-icon" href="/images/metope-icon.png" />
    <title>Metope — Android file transfer for macOS</title>
  </head>
  <body style={`--limestone: url('${texture.src}')`}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      <a href="#" class="wordmark" aria-label="Metope home"><img src="/images/metope-icon.png" width="32" height="32" alt="" /><span>metope</span></a>
      <nav aria-label="Main navigation"><a href="#features">Features</a><a href="#setup">Setup</a><a href="#help">Help</a></nav>
      <a class="button button-small" href={download} download>Download <span aria-hidden="true">↓</span></a>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-intro wrap">
          <img src="/images/metope-icon-large.png" class="hero-icon" width="256" height="256" alt="Metope’s limestone Android figure holding a file" fetchpriority="high" />
          <h1 id="hero-title">Android file transfer.<br />Built for the Mac.</h1>
          <p class="description">A small, native Swift app for your Android files.<br class="desktop-break" /> Browse, organize, and move them over USB.</p>
          <a class="button" href={download} download>Download for Mac <span aria-hidden="true">↓</span></a>
          <p class="requirements">macOS 26+ · Apple Silicon · v0.1.0</p>
        </div>
        <div class="window-scene wrap">
          <figure class="app-window" data-app-window>
            <Image src={browser} alt="Metope’s native Mac file browser with Android folders, sidebar favorites, and transfer controls." widths={[760, 1200, 2200]} sizes="(max-width: 700px) 92vw, 82vw" format="webp" quality={92} loading="eager" />
          </figure>
        </div>
      </section>

      <section class="native-section wrap" aria-labelledby="native-title">
        <div class="native-copy"><p class="eyebrow">Made with Swift & SwiftUI</p><h2 id="native-title">A proper Mac app.<br />About 5 MB.</h2><p>Native controls, Quick Look, Finder drag and drop, and familiar keyboard shortcuts. Everything you need to manage files, in a small download.</p></div>
        <div class="size-graphic" aria-label="Approximately 5 megabytes installed">
          <span class="size-value">5<span>MB</span></span>
          <div class="size-rule"><span></span><span></span><span></span><span></span><span></span></div>
          <p>The whole app, installed.</p>
          <p class="size-note">Around 3 MB to download.</p>
        </div>
      </section>

      <section class="features-section" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <div class="section-heading"><h2 id="features-title">Your files, within reach.</h2><p>From a single photo to a folder of recordings.</p></div>
          <div class="features-grid">
            {features.map(feature => <article><div class="diagram-surface"><FeatureDiagram kind={feature.kind} /></div><h3>{feature.title}</h3><p>{feature.description}</p><span class="feature-detail">{feature.detail}</span></article>)}
          </div>
          <div class="file-note"><span aria-hidden="true">↳</span><p>Existing files stay intact. Metope won’t overwrite them, and checks downloaded file sizes before saving.</p></div>
        </div>
      </section>

      <section id="setup" class="setup-section wrap" aria-labelledby="setup-title">
        <div><p class="eyebrow">Getting connected</p><h2 id="setup-title">One cable. <br />Three steps.</h2></div>
        <ol class="steps">
          <li><span aria-hidden="true">01</span><div><h3>Connect your Android.</h3><p>Use a USB cable that supports data.</p></div></li>
          <li><span aria-hidden="true">02</span><div><h3>Select File Transfer.</h3><p>Unlock your device, open its USB settings, and allow file access.</p></div></li>
          <li><span aria-hidden="true">03</span><div><h3>Open Metope.</h3><p>Browse your storage. Drag in files from Finder, or select files to save to your Mac.</p></div></li>
        </ol>
      </section>

      <section id="help" class="help-section wrap" aria-labelledby="help-title">
        <h2 id="help-title">A little help.</h2>
        <div class="questions">
          <details><summary>Which devices are supported?<span aria-hidden="true">+</span></summary><p>Metope uses MTP, the USB file-transfer protocol supported by Android phones and many other Android devices. You need an Apple Silicon Mac with macOS 26 or later.</p></details>
          <details><summary>My device isn’t showing up.<span aria-hidden="true">+</span></summary><p>Check that the cable supports data, unlock your device, and select File Transfer in its USB settings. Quit other Android file-transfer apps, then refresh Metope.</p></details>
          <details><summary>Can I try it without a device?<span aria-hidden="true">+</span></summary><p>Choose Help → Show Sample Files to browse read-only sample data.</p></details>
          <details><summary>Keyboard shortcuts<span aria-hidden="true">+</span></summary><dl class="shortcuts">{shortcuts.map(([name, keys]) => <div><dt>{name}</dt><dd><kbd>{keys}</kbd></dd></div>)}</dl></details>
        </div>
      </section>
      <section class="download-section" aria-labelledby="download-title">
        <div class="wrap download-inner"><img src="/images/metope-icon-large.png" width="100" height="100" alt="" loading="lazy" /><div><h2 id="download-title">Metope for Mac.</h2><p>Native Swift. Small download. Android file transfer.</p></div><a class="button" href={download} download>Download v0.1.0 <span aria-hidden="true">↓</span></a></div>
      </section>
    </main>
    <footer class="wrap"><span>Metope</span><span>macOS 26+ · Apple Silicon</span><a href="#main">Back to top ↑</a></footer>
    <script>
      const appWindow = document.querySelector<HTMLElement>('[data-app-window]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (appWindow) {
        let pending = false;
        const update = () => {
          pending = false;
          const progress = reduceMotion.matches ? 1 : Math.min(1, Math.max(0, window.scrollY / 460));
          const tilt = 1 - progress;
          appWindow.style.transform = `perspective(1600px) rotateX(${8 * tilt}deg) rotateY(${-5 * tilt}deg) rotateZ(${-2.5 * tilt}deg)`;
        };
        const schedule = () => { if (!pending) { pending = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', schedule, { passive: true });
        reduceMotion.addEventListener('change', schedule);
        update();
      }
    </script>
  </body>
</html>
